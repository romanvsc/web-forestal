---
title: "Servicios Forestales | Forestal Garuhapé SA"
description: "Servicios forestales de cosecha, transporte, biomasa, caminos, playas de acopio y consultoría para la cadena foresto-industrial."
seo:
  title: "Servicios Forestales | Forestal Garuhapé SA"
  description: "Servicios forestales de cosecha, transporte, biomasa, caminos, playas de acopio y consultoría para la cadena foresto-industrial."
  image: "/images/servicios/1470.png"
  type: article
layout: layouts/base.njk
---
{% from "components/image.njk" import responsiveImage with context %}
{% from "components/icon.njk" import icon with context %}
<section class="page-intro">
  <div class="site-container">
    <p class="eyebrow">Servicios</p>
    <h1>Nuestras capacidades.</h1>
    <p>Soluciones forestales para distintas etapas de la cadena foresto-industrial.</p>
  </div>
</section>
<section class="page-content">
  <div class="site-container catalog-grid">
    {% for item in todos_los_servicios %}
    {% set detailUrl = "/servicios/" + item.slug + "/" %}
    {% if item.slug == "consultoria-forestal" %}{% set detailUrl = "/consultoria/" %}{% endif %}
    <article class="service-card">
      <figure class="service-card-media">
        {{ responsiveImage(item.imagen, "", "", "lazy", "(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 33vw") }}
      </figure>
      <div class="service-card-body">
        <h2>{{ item.titulo }}</h2>
        <p>{{ item.descripcion | striptags | trim | truncate(190, true, "…") }}</p>
        <a class="text-link" href="{{ detailUrl }}">Conocer el servicio {{ icon("arrow-right") }}</a>
      </div>
    </article>
    {% endfor %}
  </div>
</section>
