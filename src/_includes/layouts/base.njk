<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% include "components/meta.njk" %}
    <link rel="preload" href="{{ assets.fonts.manrope }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ assets.fonts.workSans }}" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ assets.css }}">
    <script type="module" src="{{ assets.js }}"></script>
    {% if homeV2 %}<noscript><style>.home-v2 .site-header{position:relative}</style></noscript>{% endif %}
  </head>
  <body{% if homeV2 %} class="home-v2"{% endif %}>
    <a class="skip-link" href="#contenido-principal">Saltar al contenido</a>
    {% include "components/header.njk" %}
    <main id="contenido-principal">
      {{ content | safe }}
    </main>
    {% include "components/footer.njk" %}
  </body>
</html>
