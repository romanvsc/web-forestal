{% from "components/icon.njk" import icon with context %}
<header class="site-header" data-site-header>
  <div class="site-container header-inner">
    <a class="site-brand" href="/" aria-label="Forestal Garuhapé SA, inicio">
      <img src="/images/fg-negative.svg" alt="Forestal Garuhapé SA" width="215" height="116">
    </a>
    <button class="menu-toggle" type="button" aria-controls="site-menu" aria-expanded="false" aria-label="Abrir menú de navegación" data-menu-toggle>
      {{ icon("menu-2", "icon menu-open-icon") }}
      {{ icon("x", "icon menu-close-icon") }}
    </button>
    <nav aria-label="Navegación principal">
      <ul class="nav-links" id="site-menu" data-site-menu>
        <li><a href="/servicios/"{% if page.url == '/servicios/' %} aria-current="page"{% elif '/servicios/' in page.url or page.url == '/consultoria/' %} class="nav-section-active"{% endif %}>Servicios</a></li>
        <li><a href="/nosotros/"{% if page.url == '/nosotros/' %} aria-current="page"{% endif %}>Nosotros</a></li>
        <li><a href="/#sgi">SGC</a></li>
        <li><a class="button button--nav" href="/#contacto">Consultar {{ icon("arrow-up-right", "icon") }}</a></li>
      </ul>
    </nav>
  </div>
</header>
