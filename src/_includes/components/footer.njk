{% from "components/icon.njk" import icon with context %}
<footer class="site-footer">
  <section class="contact-section" id="contacto" aria-labelledby="contact-heading">
    <div class="site-container contact-layout">
      <div class="contact-copy">
        <p class="eyebrow eyebrow--light">Contacto comercial</p>
        <h2 id="contact-heading">Hablemos de su operación.</h2>
        <p>Cuéntenos qué necesita y el equipo de Forestal Garuhapé SA recibirá su consulta.</p>
        <div class="contact-direct">
          <a href="mailto:{{ site.email }}">{{ icon("mail") }}{{ site.email }}</a>
          <a href="tel:+5493743485849">{{ icon("phone") }}{{ site.telephone }}</a>
          <a href="https://api.whatsapp.com/send?phone=5493743485849&amp;text=Hola" target="_blank" rel="noopener noreferrer">{{ icon("brand-whatsapp") }}Escribir por WhatsApp<span class="visually-hidden"> (abre en otra pestaña)</span></a>
        </div>
      </div>

      <form class="contact-form" action="/enviar_mensaje.php" method="post" data-contact-form>
        <div class="form-status" data-form-status role="status" aria-live="polite" tabindex="-1" hidden></div>
        <div class="field-trap" aria-hidden="true">
          <label for="website">Dejar vacío</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off">
        </div>
        <div class="form-row">
          <div class="form-field">
            <label for="nombre">Nombre</label>
            <input id="nombre" name="nombre" type="text" autocomplete="name" required aria-describedby="nombre-error" data-contact-field>
            <span class="field-error" id="nombre-error" data-field-error="nombre" hidden></span>
          </div>
          <div class="form-field">
            <label for="email">Correo electrónico</label>
            <input id="email" name="email" type="email" autocomplete="email" required aria-describedby="email-error" data-contact-field>
            <span class="field-error" id="email-error" data-field-error="email" hidden></span>
          </div>
        </div>
        <div class="form-field">
          <label for="mensaje">¿En qué podemos ayudarle?</label>
          <textarea id="mensaje" name="mensaje" rows="5" required aria-describedby="mensaje-hint mensaje-error" data-contact-field></textarea>
          <p class="field-hint" id="mensaje-hint">El mensaje queda editable antes de enviarlo.</p>
          <span class="field-error" id="mensaje-error" data-field-error="mensaje" hidden></span>
        </div>
        <p class="form-privacy">Al enviar, sus datos se procesan según la <a href="/privacidad/">política de privacidad</a>.</p>
        <button class="button button--light form-submit" type="submit" data-submit-button>
          <span data-submit-label>Enviar consulta</span>{{ icon("arrow-right", "icon") }}
        </button>
      </form>
    </div>
  </section>

  <div class="footer-lower">
    <div class="site-container footer-grid">
      <div class="footer-identity">
        <a class="footer-brand" href="/" aria-label="Forestal Garuhapé SA, inicio">
          <img src="/images/fg-negative.svg" alt="" width="215" height="116" loading="lazy">
        </a>
        <p>Servicios forestales y logística para la cadena foresto-industrial.</p>
      </div>
      <div>
        <h2 class="footer-heading">Compañía</h2>
        <ul class="footer-links">
          <li><a href="/servicios/">Servicios</a></li>
          <li><a href="/nosotros/">Nosotros y SGC</a></li>
          <li><a href="/trabaja/">Empleo</a></li>
          <li><a href="/privacidad/">Privacidad</a></li>
          <li><a href="/terminos/">Términos</a></li>
        </ul>
      </div>
      <div class="footer-careers">
        <h2 class="footer-heading">Oportunidades</h2>
        <p>Las postulaciones y los CV se reciben a través de Vogel Consultoría.</p>
        <a href="https://vogelconsultoria.com.ar" target="_blank" rel="noopener noreferrer">Enviar CV en Vogel Consultoría {{ icon("arrow-up-right", "icon") }}<span class="visually-hidden"> (abre en otra pestaña)</span></a>
      </div>
    </div>
    <div class="site-container footer-meta">
      <span>© <span data-current-year>2026</span> Forestal Garuhapé SA</span>
      <a href="https://forestalgaruhape.com.ar">forestalgaruhape.com.ar</a>
    </div>
  </div>
</footer>
