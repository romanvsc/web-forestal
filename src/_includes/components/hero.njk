{% from "components/image.njk" import responsiveImage with context %}
{% from "components/icon.njk" import icon with context %}
<section class="hero" id="inicio" aria-labelledby="home-heading">
  <div class="site-container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Forestal Garuhapé SA · Operación forestal</p>
      <h1 id="home-heading">Del bosque a la industria.</h1>
      <p>Servicios forestales para conectar cosecha, transporte, caminos, biomasa, acopio y consultoría.</p>
      <div class="hero-actions">
        <a class="button" href="/#contacto">Consultar {{ icon("arrow-up-right", "icon") }}</a>
        <a class="button button--outline" href="/servicios/">Explorar servicios {{ icon("arrow-right", "icon") }}</a>
      </div>
    </div>
    <figure class="hero-media" data-hero-media>
      {{ responsiveImage("/images/actualizadas/cosecha-forestal.png", "Máquina forestal trabajando entre plantaciones", "hero-poster", "eager", "(max-width: 767px) 100vw, (max-width: 1023px) 56vw, 58vw") }}
      <video class="hero-video" data-hero-video controls playsinline preload="none" poster="/images/actualizadas/cosecha-forestal.png" aria-label="Video de una operación forestal" hidden>
        <source data-video-source data-src="/images/hero-forestal.mp4" type="video/mp4">
        <source data-video-source data-src="/images/hero-forestal.webm" type="video/webm">
      </video>
      <button class="hero-play" type="button" aria-label="Reproducir video de la operación forestal" data-hero-play>
        {{ icon("player-play", "icon") }}
      </button>
      <figcaption>Operación forestal · Forestal Garuhapé SA</figcaption>
      <p class="visually-hidden" data-video-status role="status" aria-live="polite"></p>
    </figure>
  </div>
</section>
