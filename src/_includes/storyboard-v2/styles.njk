h:85%;margin-left:auto}.stock .chapter-photo figcaption,.stock .description{color:#3d564a}.roads .chapter-photo{height:300px;z-index:auto}.roads{min-height:0;background:var(--night)}.consulting .chapter-photo{height:230px}.consulting .chapter-links{margin-top:18px}.catalog-close{padding:30px var(--gutter) 60px;text-align:left}.company{padding:70px var(--gutter)}.company-top{display:block}.year{font-size:clamp(6rem,30vw,13rem)}.company-top h2{font-size:26px;margin-top:40px}.company-bottom{display:block;margin-top:45px}.company-bottom img{height:300px}.company-bottom>div{margin-top:35px;font-size:16px}.company-bottom p{max-width:none}.sgc{padding:70px var(--gutter)}.sgc h2{font-size:clamp(2.1rem,8.5vw,3.8rem)}.sgc-subtitle{font-size:14px}.sgc-list{margin:60px 0 0}.sgc-list li{padding:35px 0}.sgc-list h3{font-size:clamp(1.65rem,7.2vw,3.5rem)}.sgc-list p{font-size:16px}.regional{display:block;padding:70px var(--gutter)}.regional h2{font-size:clamp(2.5rem,10vw,4.5rem)}.regional-copy>p{font-size:16px}.regional ul{font-size:24px;margin:25px 0}.regional figure{margin-top:30px}.regional img{max-height:470px}.contact{padding:70px var(--gutter)}.contact h2{font-size:clamp(2.2rem,9.4vw,4.5rem)}.contact-bottom{display:block;margin-top:45px}.contact-channels a{font-size:14px}.contact-composition{margin-top:40px}.contact-channels p{font-size:20px}.contact .action{width:100%;justify-content:space-between}.preview-footer{flex-wrap:wrap;gap:0 25px;font-size:11px}.preview-footer span{width:100%;padding-bottom:10px}.transition-review,.script-summary{padding:60px var(--gutter)}.transition-review h2,.script-summary h2{font-size:32px}.transition-review>p,.script-summary>p{font-size:16px}.transition-grid{grid-template-columns:1fr;gap:45px;margin-top:45px}.transition-grid h3{font-size:20px}.sample{height:300px}.pause-transition .sample-next>span{font-size:26px}.range-label{display:flex;font-size:13px}.range-steps{font-size:11px}.script-summary ol{font-size:16px;line-height:1.7}.script-summa