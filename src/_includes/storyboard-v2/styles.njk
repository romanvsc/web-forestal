@font-face{font-family:Manrope;src:url('{{ assets.fonts.manrope }}') format('woff2');font-weight:200 800;font-display:swap}
@font-face{font-family:'Work Sans';src:url('{{ assets.fonts.workSans }}') format('woff2');font-weight:100 900;font-display:swap}
:root{color-scheme:dark;--forest:#082d25;--night:#061c17;--brand:#0f766e;--cream:#f1eee6;--white:#f7f7f6;--muted:#cbd9d2;--gutter:48px}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:20px}body{margin:0;background:var(--night);color:var(--white);font:18px/1.55 'Work Sans',sans-serif;text-rendering:optimizeLegibility}h1,h2,h3,p,figure{margin:0}h1,h2,h3{font-family:Manrope,sans-serif;font-weight:700;letter-spacing:-.035em;line-height:1.06;text-wrap:balance}a{color:inherit;text-decoration-thickness:1px;text-underline-offset:.3em}button,input,textarea{font:inherit}a,button,summary,input{touch-action:manipulation}a:hover{text-decoration-thickness:2px}a:active,summary:active{opacity:.8}:focus-visible{outline:3px solid #bde4d4;outline-offset:5px}::selection{background:#0f766e;color:#fff}img{display:block;max-width:100%;height:auto}picture{display:block}.icon{width:20px;height:20px;display:inline-block;vertical-align:middle;flex:none}.sr-only,.skip:not(:focus){position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}.skip:focus{position:fixed;left:20px;top:12px;background:var(--cream);color:var(--night);padding:12px;z-index:20}section[id]{scroll-margin-top:20px}
.review-bar{min-height:48px;display:flex;align-items:center;justify-content:space-between;padding:0 24px;background:var(--cream);color:var(--night);font-size:12px;letter-spacing:.06em;border-bottom:1px solid #d4d6cc}.review-bar strong{margin-left:8px}.review-bar nav{display:flex;align-items:center;gap:24px}.review-bar a{display:inline-flex;align-items:center;gap:8px;min-height:48px}.review-bar .icon{width:16px;height:16px}
.hero{position:relative;min-height:calc(100svh - 48px);isolation:isolate;display:flex;flex-direction:column;justify-content:flex-end;padding:160px var(--gutter) 32px}.hero>picture{position:absolute;inset:0;z-index:-2}.hero-photo{width:100%;height:100%;object-fit:cover;object-position:60% 50%}.hero:after{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(6,28,23,.82),rgba(6,28,23,.2) 78%),linear-gradient(0deg,rgba(6,28,23,.78),transparent 40%)}.hero-header{position:absolute;top:16px;left:var(--gutter);right:var(--gutter);display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{width:142px;height:76px;object-fit:contain}.hero-header nav{display:flex;gap:32px;align-items:center;font-size:15px}.hero-header nav>a{display:inline-flex;align-items:center;min-height:48px;text-decoration:none}.action{display:inline-flex;justify-content:center;align-items:center;gap:24px;padding:14px 20px;min-height:48px;border:1px solid currentColor;text-decoration:none;font-size:15px;font-weight:600;transition:background-color 160ms cubic-bezier(.23,1,.32,1),color 160ms cubic-bezier(.23,1,.32,1)}.action:hover{background:var(--cream);color:var(--night)}.hero-copy{margin-block:auto 60px}.meta{font-size:12px;letter-spacing:.13em;margin-bottom:28px}.hero h1{font-size:clamp(4.5rem,9vw,9rem);line-height:1.01;letter-spacing:-.035em}.hero-base{display:flex;gap:60px;align-items:flex-end;font-size:15px;border-top:1px solid #aabdb180;padding-top:22px}.hero-base span{font-size:10px;letter-spacing:.1em;color:var(--muted)}.hero-base>a{margin-left:auto;display:flex;gap:16px;align-items:center;min-height:48px;text-decoration:none}
.note{background:#e4e8df;color:var(--night);font-size:14px;border-bottom:1px solid #bbc9bf;color-scheme:light}.note>summary{padding:16px var(--gutter);cursor:pointer;min-height:48px}.note-body{padding:4px var(--gutter) 24px;max-width:1100px}.note-body p{max-width:85ch}.video-review{margin-top:16px}.video-review>summary{min-height:48px;cursor:pointer;display:list-item;padding:10px 0}.video-review video{max-width:100%;width:720px;margin-top:8px}
.story-intro{padding:130px var(--gutter) 90px;background:var(--night)}.story-intro h2{font-size:clamp(2.8rem,6.1vw,6rem)}.intro-bottom{display:flex;align-items:start;justify-content:space-between;gap:48px;margin-top:70px}.intro-bottom>p{max-width:30ch;color:var(--muted)}.intro-bottom nav{display:grid;grid-template-columns:repeat(3,auto);gap:4px 32px;font-size:14px}.intro-bottom a{min-height:48px;display:flex;align-items:center;text-decoration:none}
.chapter{position:relative;min-height:900px;padding:120px var(--gutter) 80px;isolation:isolate;display:grid;align-items:center;gap:48px;grid-template-columns:1fr 1fr}.chapter-photo{position:relative;min-width:0}.chapter-photo picture{height:100%}.chapter-photo img{width:100%;height:100%;object-fit:cover}.chapter-photo figcaption{font-size:11px;letter-spacing:.05em;margin-top:12px;color:var(--muted)}.chapter-index{font-size:12px;letter-spacing:.09em;margin-bottom:32px}.chapter-index span{font-size:40px;font-family:Manrope;letter-spacing:-.025em;margin-right:16px;font-weight:600;vertical-align:middle}.chapter h2{font-size:clamp(2.8rem,5.6vw,5.5rem)}.description{margin-top:30px;max-width:35ch;font-size:18px;color:var(--muted)}.chapter-links{display:flex;gap:30px;margin-top:28px;flex-wrap:wrap}.chapter-links a{display:inline-flex;align-items:center;gap:10px;min-height:48px;font-size:14px;text-decoration:none;border-bottom:1px solid #8fa69a}
.harvest{display:block;padding-top:64px}.harvest .chapter-photo{width:75%;height:570px;margin-left:auto}.harvest .chapter-copy{position:relative;margin-top:-165px;max-width:760px}.harvest .chapter-copy h2{max-width:13ch;text-shadow:0 2px 16px #061c17}.harvest .chapter-photo:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(6,28,23,.7),transparent 65%);pointer-events:none}.harvest .chapter-index{position:relative;z-index:1}.harvest .chapter-photo figcaption{padding-left:40%;margin-top:20px}
