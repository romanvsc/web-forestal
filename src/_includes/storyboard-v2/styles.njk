.contact{padding:120px var(--gutter);background:var(--night)}.contact h2{font-size:clamp(3rem,7.6vw,7.5rem)}.contact-bottom{margin-top:90px;display:grid;grid-template-columns:40% 1fr;gap:60px}.contact-channels p{font-size:24px;margin-bottom:30px}.contact-channels a{display:flex;gap:12px;min-height:48px;align-items:center;font-size:15px;overflow-wrap:anywhere}.contact-composition label{display:block;font-size:13px}.fields{display:grid;grid-template-columns:1fr 1fr;gap:25px;margin-bottom:24px}.contact-composition input,.contact-composition textarea{display:block;width:100%;border:1px solid #718b7d;background:#0c2920;color:var(--white);padding:16px;margin-top:10px;border-radius:0;caret-color:#bde4d4;min-height:52px;resize:vertical}.contact-composition ::placeholder{color:#cbd9d2}.form-note{font-size:12px;color:var(--muted);margin:20px 0 24px;max-width:55ch}.preview-footer{display:flex;gap:32px;align-items:center;padding:24px var(--gutter);border-top:1px solid #688274;font-size:12px}.preview-footer span{margin-right:auto}.preview-footer a{min-height:48px;display:flex;align-items:center}
.transition-review,.script-summary{padding:100px var(--gutter);background:var(--cream);color:var(--night);color-scheme:light}.transition-review{border-top:10px solid var(--brand)}.transition-review h2,.script-summary h2{font-size:clamp(2.4rem,4vw,4rem)}.transition-review>p,.script-summary>p{max-width:70ch;margin-top:28px}.transition-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:30px;margin-top:65px}.transition-grid h3{font-size:20px;margin-bottom:20px}.sample{--progress:0;position:relative;height:310px;isolation:isolate;overflow:clip;background:var(--night)}.sample>picture,.sample-next>picture{position:absolute;inset:0}.sample img{height:100%;width:100%;object-fit:cover}.sample-caption{position:absolute;left:16px;bottom:16px;color:var(--white);background:var(--night);padding:4px 8px;font-size:11px}.expansion>picture{clip-path:inset(0 calc(12.5% * (1 - var(--progress))));transform:scale(calc(1 + .08 * var(--progress)))}.sample-next{position:absolute;inset:0;opacity:var(--progress)}.dissolve .sample-next{background:var(--cream);display:flex;justify-content:center}.dissolve .sample-next>picture{left:20%;right:20%}.pause-transition{background:var(--cream);display:flex;align-items:center;justify-content:center}.sample-year{font:600 86px/1 Manrope;color:var(--night)}.pause-transition .sample-next img{filter:brightness(.25)}.pause-transition .sample-next>span{position:absolute;left:20px;top:40%;font:700 clamp(1.2rem,2vw,2rem)/1.1 Manrope;color:var(--white)}.range-label{display:flex;justify-content:space-between;font-size:12px;margin-top:24px;gap:16px}.range-label output{font-variant-numeric:tabular-nums}.transition-grid input{width:100%;min-height:48px;accent-color:var(--brand);cursor:ew-resize}.range-steps{display:flex;justify-content:space-between;font-size:10px;color:#42564a}.script-summary{border-top:1px solid #bfcac1}.script-summary ol{padding-left:24px;margin-top:35px;line-height:2}.script-summary .ink-link{margin-top:25px}
/* Correcciones de revisión: contraste del logo y relevo de títulos sin superposición. */
html{scroll-behavior:auto}.brand{filter:brightness(0) invert(1)}.sample-year{opacity:calc(1 - 2 * var(--progress))}.pause-transition .sample-next>span{opacity:calc(2 * var(--progress) - 1)}
.pause-transition .sample-next{background:linear-gradient(rgba(6,28,23,.7),rgba(6,28,23,.7)),url('{{ assets.images["/images/actualizadas/consultoria-forestal.png"].webp[1].url }}') center/cover,var(--night);z-index:1}.pause-transition .sample-next>picture{display:none}.pause-transition .sample-next>span{z-index:2}
