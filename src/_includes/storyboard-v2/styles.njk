.stock{background:var(--cream);color:var(--night);grid-template-columns:44% 1fr;gap:10%;padding-top:100px;padding-bottom:100px}.stock .chapter-photo{height:700px}.stock .chapter-photo img{object-position:center}.stock .description,.stock figcaption{color:#3d564a}.stock .chapter-links a{border-color:#627c6e}
.roads{min-height:900px;display:block;display:flex;align-items:flex-end;padding-top:90px;overflow:clip}.roads .chapter-photo{position:absolute;inset:0;z-index:-2}.roads .chapter-photo:after{position:absolute;inset:0;content:'';background:linear-gradient(0deg,rgba(6,28,23,.95),rgba(6,28,23,.15) 90%)}.roads .chapter-photo figcaption{position:absolute;right:var(--gutter);top:30px;padding:10px 14px;background:#061c17c9;margin:0}.roads .chapter-copy{max-width:850px}.roads h2{font-size:clamp(2.8rem,6vw,6rem)}
.biomass{display:block;background:var(--forest);padding-top:90px}.biomass .chapter-photo{width:82%;height:590px;margin-left:auto}.biomass .chapter-copy{margin-top:-100px;position:relative;max-width:700px}.biomass .chapter-copy h2{text-shadow:0 2px 16px #061c17}.biomass .chapter-photo:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,45,37,.75),transparent 80%);pointer-events:none}.biomass figcaption{padding-left:50%}
.consulting{display:block;padding-top:100px}.consulting .chapter-photo{width:75%;height:440px;margin:0 auto}.consulting .chapter-copy{display:grid;grid-template-columns:1.6fr 1fr;gap:0 60px;margin-top:65px}.consulting .chapter-index{grid-column:1/-1;margin-bottom:20px}.consulting h2{grid-row:2/4}.consulting .description{margin-top:0}.consulting .chapter-links{grid-column:2;gap:20px}.catalog-close{padding:24px var(--gutter) 85px;text-align:right;background:var(--night)}
.company{background:var(--cream);color:var(--night);padding:120px var(--gutter)}.company-top{display:flex;align-items:center;justify-content:space-between;gap:60px}.year{font-family:Manrope;font-size:clamp(7rem,18vw,18rem);line-height:1;font-weight:600;letter-spacing:-.04em}.company-top h2{font-size:clamp(1.8rem,2.8vw,2.8rem);font-weight:600;max-width:22ch}.company-bottom{margin-top:110px;display:grid;grid-template-columns:58% 1fr;gap:70px;align-items:center}.company-bottom img{width:100%;height:490px;object-fit:cover}.company-bottom figcaption{font-size:11px;margin-top:12px}.company-bottom p{max-width:33ch;margin-bottom:24px}.ink-link{display:inline-flex;align-items:center;gap:16px;min-height:48px;font-size:15px}
.sgc{position:relative;padding:125px var(--gutter);isolation:isolate;overflow:clip}.sgc-backdrop{position:absolute;inset:0;z-index:-2}.sgc-backdrop picture,.sgc-backdrop img{height:100%;width:100%}.sgc-backdrop img{object-fit:cover;object-position:40% center;filter:brightness(.23) saturate(.7)}.sgc h2{font-size:clamp(2.8rem,6.2vw,6.2rem)}.sgc-subtitle{margin-top:30px;color:var(--muted)}.sgc-list{list-style:none;padding:0;margin:120px 0 0 20%}.sgc-list li{padding:65px 0;border-top:1px solid #6e8e7c}.sgc-list h3{font-size:clamp(2rem,4.5vw,4.5rem);font-weight:600}.sgc-list p{color:var(--muted);max-width:48ch;margin-top:18px}
