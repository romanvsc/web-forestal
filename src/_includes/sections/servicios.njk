{% from "components/image.njk" import responsiveImage with context %}
{% from "components/icon.njk" import icon with context %}
<section class="section-block" id="servicios" aria-labelledby="services-heading">
  <div class="site-container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Capacidades</p>
        <h2 id="services-heading">Una cadena de servicios, conectada.</h2>
      </div>
      <p>Conozca cada prestación, revise su alcance y encuentre un canal directo para consultar.</p>
    </div>
    <div class="service-grid">
      {% for item in todos_los_servicios %}
      {% set detailUrl = "/servicios/" + item.slug + "/" %}
      {% if item.slug == "consultoria-forestal" %}{% set detailUrl = "/consultoria/" %}{% endif %}
      <article class="service-card">
        <figure class="service-card-media">
          {{ responsiveImage(item.imagen, "", "", "lazy", "(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 33vw") }}
        </figure>
        <div class="service-card-body">
          <h3>{{ item.titulo }}</h3>
          <p>{{ item.descripcion | striptags | trim | truncate(165, true, "…") }}</p>
          <a class="text-link" href="{{ detailUrl }}">Conocer el servicio {{ icon("arrow-right") }}</a>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
