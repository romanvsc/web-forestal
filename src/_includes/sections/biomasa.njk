{% from "components/image.njk" import responsiveImage with context %}
{% from "components/icon.njk" import icon with context %}
{% set biomass = todos_los_servicios | selectattr("slug", "equalto", "aprovechamiento-biomasa-forestal") | first %}
<section class="section-block" aria-labelledby="biomass-heading">
  <div class="site-container biomass-grid">
    <figure class="biomass-image">
      {{ responsiveImage("/images/servicios/biomasa_3.jpeg", "Material forestal preparado para su aprovechamiento como biomasa", "", "lazy", "(max-width: 767px) 100vw, 50vw") }}
    </figure>
    <div class="biomass-copy">
      <p class="eyebrow">Aprovechamiento</p>
      <h2 id="biomass-heading">Biomasa forestal.</h2>
      <p>{{ biomass.descripcion }}</p>
      <a class="text-link" href="/servicios/aprovechamiento-biomasa-forestal/">Conocer el servicio {{ icon("arrow-right") }}</a>
    </div>
  </div>
</section>
