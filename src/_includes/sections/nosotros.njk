{% from "components/image.njk" import responsiveImage with context %}
{% from "components/icon.njk" import icon with context %}
<section class="section-block company-section" id="nosotros" aria-labelledby="company-heading">
  <div class="site-container company-grid">
    <figure class="company-image">
      {{ responsiveImage(nosotros.imagen, "Equipo y operación de Forestal Garuhapé SA", "", "lazy", "(max-width: 767px) 100vw, 48vw") }}
    </figure>
    <div class="company-copy">
      <p class="eyebrow">La empresa</p>
      <h2 id="company-heading">Experiencia en la cadena foresto-industrial.</h2>
      <p>{{ nosotros.descripcion }}</p>
      <blockquote class="company-vision">{{ nosotros.vision }}</blockquote>
      <a class="text-link" href="/nosotros/">Conocer Forestal Garuhapé SA {{ icon("arrow-right") }}</a>
    </div>
  </div>
</section>
