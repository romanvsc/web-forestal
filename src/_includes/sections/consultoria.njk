{% from "components/image.njk" import responsiveImage with context %}
{% from "components/icon.njk" import icon with context %}
{% set consultingService = todos_los_servicios | selectattr("slug", "equalto", "consultoria-forestal") | first %}
<section class="page-intro">
  <div class="site-container">
    <p class="eyebrow">Servicios / Consultoría</p>
    <h1>Consultoría forestal.</h1>
    <p>{{ consultingService.descripcion }}</p>
    <div class="page-actions">
      <a class="button" href="/?servicio=consultoria-forestal#contacto">Consultar {{ icon("arrow-up-right") }}</a>
      <a class="button button--outline" href="/servicios/">Todos los servicios {{ icon("arrow-right") }}</a>
    </div>
  </div>
</section>
<section class="page-content" aria-labelledby="consulting-heading">
  <div class="site-container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Planificación y análisis</p>
        <h2 id="consulting-heading">Áreas de consultoría.</h2>
      </div>
      <p>Herramientas y equipos profesionales para colaborar con los procesos forestales y foresto-industriales.</p>
    </div>
    <div class="consulting-grid">
      {% for servicio in consultoria %}
      <article class="consulting-card">
        {{ responsiveImage(servicio.imagen, servicio.titulo, "", "lazy", "(max-width: 767px) 38vw, (max-width: 1023px) 30vw, 18vw") }}
        <div>
          <h2>{{ servicio.titulo }}</h2>
          <p>{{ servicio.descripcion }}</p>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
