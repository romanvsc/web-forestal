{% from "components/image.njk" import responsiveImage with context %}
{% from "components/icon.njk" import icon with context %}
<section class="home-process" id="operacion" aria-labelledby="process-heading">
  <div class="home-process-intro home-section-heading" data-home-reveal><div><p class="home-meta">Cómo operamos</p><h2 id="process-heading">De la planificación<br>al abastecimiento.</h2></div><p>Un recorrido entre el análisis, el trabajo en campo y la organización del recurso en industria.</p></div>
  <div class="home-operation" data-home-operation>
    <div class="home-operation-stage" data-operation-stage aria-hidden="true">
      {% for scene in homeNarrative %}<figure class="operation-frame" data-operation-frame>{{ responsiveImage(scene.image, '', '', 'lazy', '(max-width: 1023px) 1px, 100vw') }}</figure>{% endfor %}
      <div class="operation-meter"><p class="operation-meter-count"><span data-operation-num>01</span><span class="operation-meter-total">/ {{ "0" + homeNarrative.length }}</span></p><span class="operation-meter-track"><span class="operation-meter-fill" data-operation-fill></span></span><p class="operation-caption" data-operation-caption>Planificar</p></div>
    </div>
    <div class="home-operation-track" data-operation-track>
      {% for scene in homeNarrative %}
      <article class="operation-chapter" id="{{ scene.id }}" aria-labelledby="scene-{{ scene.id }}" data-operation-chapter data-operation-title="{{ scene.title }}">
        <figure class="operation-static-photo">{{ responsiveImage(scene.image, scene.alt, '', 'lazy', '(max-width: 767px) 100vw, 60vw') }}<figcaption>{{ scene.caption }}</figcaption></figure>
        <div class="operation-copy"><p class="operation-index"><span>{{ scene.number }}</span> / {{ scene.title | upper }}</p><h3 id="scene-{{ scene.id }}">{% for line in scene.line.split('\n') %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</h3><p class="operation-description">{{ scene.copy }}</p><div class="operation-links"><a href="{{ scene.detail }}">Conocer el servicio {{ icon('arrow-up-right') }}</a><a href="/?servicio={{ scene.service }}#contacto">Consultar {{ icon('arrow-right') }}</a></div></div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
